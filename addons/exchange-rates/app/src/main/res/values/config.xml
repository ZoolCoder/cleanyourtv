<!-- The currencies to show against the Sudanese pound, one tile each, in this order. A line is
     "ISO code | Arabic name | English name". The code must be one the source lists (about 160 currencies);
     a code it does not have shows a dash. Eight tiles fill the screen in two rows of four.
     Edit the list before you build; add or drop lines freely. -->
<resources>
    <string-array name="currencies" translatable="false">
